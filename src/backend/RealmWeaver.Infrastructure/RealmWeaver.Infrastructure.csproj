<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared plumbing only: how a module registers its own DbContext, how module databases are migrated
    and seeded at startup, and HTTP error mapping. It never references a module, so modules can depend on it.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
